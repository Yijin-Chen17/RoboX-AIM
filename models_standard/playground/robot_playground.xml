<mujoco model="robox_v2_playground">
  <compiler angle="radian" eulerseq="xyz" meshdir="../robox_v2/meshes" autolimits="true" balanceinertia="true" boundinertia="1e-8" />

  <default>
    <joint armature="0.1" damping="1.0" />
  </default>

  <visual>
    <headlight ambient="0.15 0.15 0.15" diffuse="0.0 0.0 0.0" specular="0.0 0.0 0.0" />
    <quality shadowsize="4096" />
    <global offwidth="1920" offheight="1080" />
    <map shadowclip="0.5" shadowscale="0.8" />
  </visual>

  <!-- ROBOX V2 Visual OBJ Meshes -->
  <asset>
    <mesh name="part_01" file="part_01.obj" />
    <mesh name="part_02" file="part_02.obj" />
    <mesh name="part_03" file="part_03.obj" />
    <mesh name="part_04" file="part_04.obj" />
    <mesh name="part_05" file="part_05.obj" />
    <mesh name="part_06" file="part_06.obj" />
    <mesh name="part_07" file="part_07.obj" />
    <mesh name="part_08" file="part_08.obj" />
    <mesh name="part_09" file="part_09.obj" />
    <mesh name="part_10" file="part_10.obj" />
    <mesh name="part_11" file="part_11.obj" />
    <mesh name="part_12" file="part_12.obj" />
    <mesh name="part_13" file="part_13.obj" />
  </asset>

  <worldbody>
    <!-- Robot Chassis & Suspensions: Defined first so root joint is Joint 0 -->
    <!-- Default spawn: 0.8m in front of 10cm vertical curb, facing directly at the obstacle (+Y) -->
    <body name="chassis" pos="0 2.2 0.228" quat="0.7071068 0 0 0.7071068">
      <freejoint name="root" />
      <inertial pos="0.008 0.0 0.015" mass="16.598" quat="1 0 0 0" diaginertia="0.230 0.230 0.440" />

      <camera name="track_cam" mode="trackcom" pos="-1.5 0 0.8" xyaxes="0 -1 0 0.8 0 1.5" />
      <camera name="side_cam" mode="trackcom" pos="-1.3 -1.1 0.7" xyaxes="0.65 -0.76 0 0.38 0.33 0.87" />

      <!-- Visual Chassis Mesh -->
      <geom name="chassis_mesh" type="mesh" mesh="part_01" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />

      <!-- Chassis Main Deck Collision (CAD 480x480x35mm plate) -->
      <geom name="chassis_deck_col" type="box" size="0.238 0.238 0.0175" pos="0 0 0.0175"
            contype="1" conaffinity="1" priority="1" friction="0.05 0.001 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

      <!-- Two Underbody Slider Rods Collision (original length, X in [-0.130, 0.375], Y = +-0.0776, Z in [-0.0275, 0.000]) -->
      <geom name="chassis_bottom_rod_L" type="box" size="0.2525 0.0055 0.01375" pos="0.1225 0.0776 -0.01375"
            contype="1" conaffinity="1" priority="2" friction="0.05 0.001 0.0001" group="3" rgba="0 0.8 0.8 0.3" />
      <geom name="chassis_bottom_rod_R" type="box" size="0.2525 0.0055 0.01375" pos="0.1225 -0.0776 -0.01375"
            contype="1" conaffinity="1" priority="2" friction="0.05 0.001 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

      <!-- ======================================================== -->
      <!-- FRONT-LEFT (LF) LEG MODULE                               -->
      <!-- ======================================================== -->
      <body name="Steering_joint_LF" pos="0.222574 0.222574 0">
        <joint name="Steering_joint_LF" type="hinge" pos="0 0 0" axis="0 0 1" actuatorfrcrange="-10 10" actuatorfrclimited="true" />
        <inertial pos="-2.852e-09 3.920e-07 -0.0391" mass="1.537" diaginertia="0.008 0.008 0.004" />
        <geom name="Steering_joint_LF_mesh" pos="-0.222574 -0.222574 0" type="mesh" mesh="part_08" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />
        <geom name="steer_col_LF" type="cylinder" size="0.027 0.035" pos="0 0 -0.035" contype="1" conaffinity="1" friction="0.3 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

        <body name="Posture_control_joint_LF" pos="0 0.02295 -0.0555">
          <joint name="Posture_control_joint_LF" type="hinge" pos="0 0 0" axis="0 -1 0" actuatorfrcrange="-12 12" actuatorfrclimited="true" />
          <inertial pos="0 0.00625 0.059" mass="1.062" diaginertia="0.003 0.002 0.002" />
          <geom name="Posture_control_joint_LF_mesh" pos="-0.222574 -0.245524 0.0555" type="mesh" mesh="part_09" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />
          <geom name="ecc_arm_col_LF" type="capsule" fromto="0 0 0 0 0.0125 0.072" size="0.022" contype="1" conaffinity="1" friction="0.2 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

          <body name="Wheel_joint_LF" pos="0 0.0125 0.072">
            <joint name="Wheel_joint_LF" type="hinge" pos="0 0 0" axis="0 -1 0" damping="0.005" actuatorfrcrange="-3 3" actuatorfrclimited="true" />
            <inertial pos="0 0.018 0" mass="0.7515" diaginertia="0.0025 0.004 0.0025" />
            <geom name="Wheel_joint_LF_mesh" pos="-0.222574 -0.258024 -0.0165" type="mesh" mesh="part_10" contype="0" conaffinity="0" group="1" rgba="0.25 0.25 0.25 1" density="0" />
            <geom name="wheel_col_LF" type="cylinder" size="0.100 0.018" pos="0 0.018 0" euler="1.5707963 0 0" contype="1" conaffinity="1" friction="0.85 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />
          </body>
        </body>
      </body>

      <!-- ======================================================== -->
      <!-- FRONT-RIGHT (RF) LEG MODULE                              -->
