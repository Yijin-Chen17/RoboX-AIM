  <!-- Include Playground Obstacle Arena Environment -->
  <include file="playground_arena.xml" />

  <!-- Keyframes Tailored for ROBOX V2 (root pos(3), root quat(4), 12 joint angles) -->
  <keyframe>
    <!-- Default spawn: 0.8m in front of 10cm vertical curb, facing directly at the obstacle (+Y) -->
    <key name="home" qpos="0.0 2.2 0.228 0.7071068 0 0 0.7071068 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
    <key name="curb_10cm" qpos="0.0 2.2 0.228 0.7071068 0 0 0.7071068 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
    <key name="curb_5cm" qpos="-1.2 2.2 0.228 0.7071068 0 0 0.7071068 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
    <key name="curb_20cm" qpos="1.2 2.2 0.228 0.7071068 0 0 0.7071068 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
    <key name="plaza" qpos="0.0 0.0 0.228 1 0 0 0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
    <key name="ramp" qpos="2.0 0.8 0.228 1 0 0 0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
    <key name="bumps" qpos="-2.0 0.8 0.228 0 0 0 1 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
    <key name="rmuc_step" qpos="5.0 2.8 0.228 0.7071068 0 0 0.7071068 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
  </keyframe>

  <!-- Actuators: Calibrated for ROBOX V2 (30.00 kg Standard) -->
  <actuator>
    <!-- Steering Actuators (DM-J4310P-2EC: 3.5 Nm rated, 12.5 Nm peak; conservative physical peak clamp 7.0 Nm) -->
    <position name="act_steer_FL" joint="Steering_joint_LF" kp="300" kv="30" forcelimited="true" forcerange="-7 7" ctrllimited="true" ctrlrange="-3.14159 3.14159" />
    <position name="act_steer_FR" joint="Steering_joint_RF" kp="300" kv="30" forcelimited="true" forcerange="-7 7" ctrllimited="true" ctrlrange="-3.14159 3.14159" />
    <position name="act_steer_RL" joint="Steering_joint_LB" kp="300" kv="30" forcelimited="true" forcerange="-7 7" ctrllimited="true" ctrlrange="-3.14159 3.14159" />
    <position name="act_steer_RR" joint="Steering_joint_RB" kp="300" kv="30" forcelimited="true" forcerange="-7 7" ctrllimited="true" ctrlrange="-3.14159 3.14159" />

    <!-- Eccentric Posture Actuators (DM-J4340P-2EC V1.1: 9.0 Nm continuous feedforward, 27 Nm peak; physical clamp 12.0 Nm) -->
    <position name="act_ecc_FL" joint="Posture_control_joint_LF" kp="300" kv="30" forcelimited="true" forcerange="-12 12" ctrllimited="false" />
    <position name="act_ecc_FR" joint="Posture_control_joint_RF" kp="300" kv="30" forcelimited="true" forcerange="-12 12" ctrllimited="false" />
    <position name="act_ecc_RL" joint="Posture_control_joint_LB" kp="300" kv="30" forcelimited="true" forcerange="-12 12" ctrllimited="false" />
    <position name="act_ecc_RR" joint="Posture_control_joint_RB" kp="300" kv="30" forcelimited="true" forcerange="-12 12" ctrllimited="false" />

    <!-- Wheel Velocity Actuators (LK MF9010 V2 17T: max 2.2 Nm, rated 1080 rpm = 113.10 rad/s) -->
    <velocity name="act_wheel_FL" joint="Wheel_joint_LF" kv="10" forcelimited="true" forcerange="-2.2 2.2" ctrllimited="true" ctrlrange="-113.10 113.10" />
    <velocity name="act_wheel_FR" joint="Wheel_joint_RF" kv="10" forcelimited="true" forcerange="-2.2 2.2" ctrllimited="true" ctrlrange="-113.10 113.10" />
    <velocity name="act_wheel_RL" joint="Wheel_joint_LB" kv="10" forcelimited="true" forcerange="-2.2 2.2" ctrllimited="true" ctrlrange="-113.10 113.10" />
    <velocity name="act_wheel_RR" joint="Wheel_joint_RB" kv="10" forcelimited="true" forcerange="-2.2 2.2" ctrllimited="true" ctrlrange="-113.10 113.10" />
  </actuator>

  <!-- Collision Excludes Between Adjacent Robot Links -->
  <contact>
    <exclude body1="chassis" body2="Steering_joint_LF" />
    <exclude body1="chassis" body2="Steering_joint_RF" />
    <exclude body1="chassis" body2="Steering_joint_LB" />
    <exclude body1="chassis" body2="Steering_joint_RB" />
    <exclude body1="chassis" body2="Posture_control_joint_LF" />
    <exclude body1="chassis" body2="Posture_control_joint_RF" />
    <exclude body1="chassis" body2="Posture_control_joint_LB" />
    <exclude body1="chassis" body2="Posture_control_joint_RB" />
    <exclude body1="chassis" body2="Wheel_joint_LF" />
    <exclude body1="chassis" body2="Wheel_joint_RF" />
    <exclude body1="chassis" body2="Wheel_joint_LB" />
    <exclude body1="chassis" body2="Wheel_joint_RB" />
    <exclude body1="Steering_joint_LF" body2="Posture_control_joint_LF" />
    <exclude body1="Steering_joint_RF" body2="Posture_control_joint_RF" />
    <exclude body1="Steering_joint_LB" body2="Posture_control_joint_LB" />
    <exclude body1="Steering_joint_RB" body2="Posture_control_joint_RB" />
    <exclude body1="Steering_joint_LF" body2="Wheel_joint_LF" />
    <exclude body1="Steering_joint_RF" body2="Wheel_joint_RF" />
    <exclude body1="Steering_joint_LB" body2="Wheel_joint_LB" />
    <exclude body1="Steering_joint_RB" body2="Wheel_joint_RB" />
    <exclude body1="Posture_control_joint_LF" body2="Wheel_joint_LF" />
    <exclude body1="Posture_control_joint_RF" body2="Wheel_joint_RF" />
    <exclude body1="Posture_control_joint_LB" body2="Wheel_joint_LB" />
    <exclude body1="Posture_control_joint_RB" body2="Wheel_joint_RB" />
  </contact>
</mujoco>
