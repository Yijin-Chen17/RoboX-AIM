        <inertial pos="-1.135e-08 -3.299e-07 -0.0391" mass="1.537" diaginertia="0.008 0.008 0.004" />
        <geom name="Steering_joint_RF_mesh" pos="-0.222574 0.222574 0" type="mesh" mesh="part_12" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />
        <geom name="steer_col_RF" type="cylinder" size="0.027 0.035" pos="0 0 -0.035" contype="1" conaffinity="1" friction="0.3 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

        <body name="Posture_control_joint_RF" pos="0 -0.02295 -0.0555">
          <joint name="Posture_control_joint_RF" type="hinge" pos="0 0 0" axis="0 1 0" actuatorfrcrange="-12 12" actuatorfrclimited="true" />
          <inertial pos="0 -0.00625 0.059" mass="1.062" diaginertia="0.003 0.002 0.002" />
          <geom name="Posture_control_joint_RF_mesh" pos="-0.222574 0.245524 0.0555" type="mesh" mesh="part_13" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />
          <geom name="ecc_arm_col_RF" type="capsule" fromto="0 0 0 0 -0.0125 0.072" size="0.022" contype="1" conaffinity="1" friction="0.2 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

          <body name="Wheel_joint_RF" pos="0 -0.0125 0.072">
            <joint name="Wheel_joint_RF" type="hinge" pos="0 0 0" axis="0 1 0" damping="0.005" actuatorfrcrange="-3 3" actuatorfrclimited="true" />
            <inertial pos="0 -0.018 0" mass="0.7515" diaginertia="0.0025 0.004 0.0025" />
            <geom name="Wheel_joint_RF_mesh" pos="-0.222574 0.258024 -0.0165" type="mesh" mesh="part_11" contype="0" conaffinity="0" group="1" rgba="0.25 0.25 0.25 1" density="0" />
            <geom name="wheel_col_RF" type="cylinder" size="0.100 0.018" pos="0 -0.018 0" euler="1.5707963 0 0" contype="1" conaffinity="1" friction="0.85 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />
          </body>
        </body>
      </body>

      <!-- ======================================================== -->
      <!-- REAR-LEFT (LB) LEG MODULE                                -->
      <!-- ======================================================== -->
      <body name="Steering_joint_LB" pos="-0.222574 0.222574 0">
        <joint name="Steering_joint_LB" type="hinge" pos="0 0 0" axis="0 0 1" actuatorfrcrange="-10 10" actuatorfrclimited="true" />
        <inertial pos="1.135e-08 3.299e-07 -0.0391" mass="1.537" diaginertia="0.008 0.008 0.004" />
        <geom name="Steering_joint_LB_mesh" pos="0.222574 -0.222574 0" type="mesh" mesh="part_02" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />
        <geom name="steer_col_LB" type="cylinder" size="0.027 0.035" pos="0 0 -0.035" contype="1" conaffinity="1" friction="0.3 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

        <body name="Posture_control_joint_LB" pos="0 0.02295 -0.0555">
          <joint name="Posture_control_joint_LB" type="hinge" pos="0 0 0" axis="0 -1 0" actuatorfrcrange="-12 12" actuatorfrclimited="true" />
          <inertial pos="0 0.00625 0.059" mass="1.062" diaginertia="0.003 0.002 0.002" />
          <geom name="Posture_control_joint_LB_mesh" pos="0.222574 -0.245524 0.0555" type="mesh" mesh="part_03" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />
          <geom name="ecc_arm_col_LB" type="capsule" fromto="0 0 0 0 0.0125 0.072" size="0.022" contype="1" conaffinity="1" friction="0.2 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

          <body name="Wheel_joint_LB" pos="0 0.0125 0.072">
            <joint name="Wheel_joint_LB" type="hinge" pos="0 0 0" axis="0 -1 0" damping="0.005" actuatorfrcrange="-3 3" actuatorfrclimited="true" />
            <inertial pos="0 0.018 0" mass="0.7515" diaginertia="0.0025 0.004 0.0025" />
            <geom name="Wheel_joint_LB_mesh" pos="0.222574 -0.258024 -0.0165" type="mesh" mesh="part_04" contype="0" conaffinity="0" group="1" rgba="0.25 0.25 0.25 1" density="0" />
            <geom name="wheel_col_LB" type="cylinder" size="0.100 0.018" pos="0 0.018 0" euler="1.5707963 0 0" contype="1" conaffinity="1" friction="0.85 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />
          </body>
        </body>
      </body>

      <!-- ======================================================== -->
      <!-- REAR-RIGHT (RB) LEG MODULE                               -->
      <!-- ======================================================== -->
      <body name="Steering_joint_RB" pos="-0.222574 -0.222574 0">
        <joint name="Steering_joint_RB" type="hinge" pos="0 0 0" axis="0 0 1" actuatorfrcrange="-10 10" actuatorfrclimited="true" />
        <inertial pos="2.852e-09 -3.920e-07 -0.0391" mass="1.537" diaginertia="0.008 0.008 0.004" />
        <geom name="Steering_joint_RB_mesh" pos="0.222574 0.222574 0" type="mesh" mesh="part_05" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />
        <geom name="steer_col_RB" type="cylinder" size="0.027 0.035" pos="0 0 -0.035" contype="1" conaffinity="1" friction="0.3 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

        <body name="Posture_control_joint_RB" pos="0 -0.02295 -0.0555">
          <joint name="Posture_control_joint_RB" type="hinge" pos="0 0 0" axis="0 1 0" actuatorfrcrange="-12 12" actuatorfrclimited="true" />
          <inertial pos="0 -0.00625 0.059" mass="1.062" diaginertia="0.003 0.002 0.002" />
          <geom name="Posture_control_joint_RB_mesh" pos="0.222574 0.245524 0.0555" type="mesh" mesh="part_06" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />
          <geom name="ecc_arm_col_RB" type="capsule" fromto="0 0 0 0 -0.0125 0.072" size="0.022" contype="1" conaffinity="1" friction="0.2 0.005 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

