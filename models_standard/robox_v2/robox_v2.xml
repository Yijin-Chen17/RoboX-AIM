  <!-- Actuators: Migrated and Calibrated for ROBOX V2 (30.00 kg) -->
  <actuator>
    <!-- Steering Actuators (Position Control: Kp=300, Kv=30, Max Torque: 3.5 Nm) -->
    <position name="act_steer_FL" joint="Steering_joint_LF" kp="300" kv="30" forcelimited="true" forcerange="-3.5 3.5" ctrllimited="true" ctrlrange="-3.14159 3.14159" />
    <position name="act_steer_FR" joint="Steering_joint_RF" kp="300" kv="30" forcelimited="true" forcerange="-3.5 3.5" ctrllimited="true" ctrlrange="-3.14159 3.14159" />
    <position name="act_steer_RL" joint="Steering_joint_LB" kp="300" kv="30" forcelimited="true" forcerange="-3.5 3.5" ctrllimited="true" ctrlrange="-3.14159 3.14159" />
    <position name="act_steer_RR" joint="Steering_joint_RB" kp="300" kv="30" forcelimited="true" forcerange="-3.5 3.5" ctrllimited="true" ctrlrange="-3.14159 3.14159" />

    <!-- Eccentric Posture Actuators (Position Control: Kp=300, Kv=30, Max Torque: 12.0 Nm) -->
    <position name="act_ecc_FL" joint="Posture_control_joint_LF" kp="300" kv="30" forcelimited="true" forcerange="-12 12" ctrllimited="false" />
    <position name="act_ecc_FR" joint="Posture_control_joint_RF" kp="300" kv="30" forcelimited="true" forcerange="-12 12" ctrllimited="false" />
    <position name="act_ecc_RL" joint="Posture_control_joint_LB" kp="300" kv="30" forcelimited="true" forcerange="-12 12" ctrllimited="false" />
    <position name="act_ecc_RR" joint="Posture_control_joint_RB" kp="300" kv="30" forcelimited="true" forcerange="-12 12" ctrllimited="false" />

    <!-- Wheel Velocity Actuators (Velocity Control: Kv=10, Max Torque: 2.2 Nm) -->
    <velocity name="act_wheel_FL" joint="Wheel_joint_LF" kv="10" forcelimited="true" forcerange="-2.2 2.2" ctrllimited="true" ctrlrange="-50 50" />
    <velocity name="act_wheel_FR" joint="Wheel_joint_RF" kv="10" forcelimited="true" forcerange="-2.2 2.2" ctrllimited="true" ctrlrange="-50 50" />
    <velocity name="act_wheel_RL" joint="Wheel_joint_LB" kv="10" forcelimited="true" forcerange="-2.2 2.2" ctrllimited="true" ctrlrange="-50 50" />
    <velocity name="act_wheel_RR" joint="Wheel_joint_RB" kv="10" forcelimited="true" forcerange="-2.2 2.2" ctrllimited="true" ctrlrange="-50 50" />
  </actuator>

  <!-- Collision Excludes Between Adjacent Links -->
  <contact>
    <exclude body1="chassis" body2="Steering_joint_LF" />
    <exclude body1="chassis" body2="Steering_joint_RF" />
    <exclude body1="chassis" body2="Steering_joint_LB" />
