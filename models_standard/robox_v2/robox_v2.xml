      <freejoint name="root" />
      <inertial pos="0.008 0.0 0.015" mass="16.598" quat="1 0 0 0" diaginertia="0.230 0.230 0.440" />

      <camera name="track_cam" mode="trackcom" pos="-1.5 0 0.8" xyaxes="0 -1 0 0.8 0 1.5" />
      <camera name="side_cam" mode="trackcom" pos="-1.3 -1.1 0.7" xyaxes="0.65 -0.76 0 0.38 0.33 0.87" />

      <!-- Visual Chassis Mesh -->
      <!-- Visual Chassis Mesh (from models_standard/robox_v2_mujoco) -->
      <geom name="chassis_mesh" type="mesh" mesh="part_01" contype="0" conaffinity="0" group="1" rgba="0.75 0.75 0.75 1" density="0" />

      <!-- Chassis Main Deck Collision (Coincides exactly with CAD 480x480x35mm plate, X in [-0.238, 0.238], Y in [-0.238, 0.238]) -->
      <geom name="chassis_deck_col" type="box" size="0.238 0.238 0.0175" pos="0 0 0.0175"
            contype="1" conaffinity="1" priority="1" friction="0.05 0.001 0.0001" group="3" rgba="0 0.8 0.8 0.3" />

      <!-- Two Underbody Slider Rods Collision (X in [-0.130, 0.375], Y = +-0.0776, Z in [-0.0275, 0.000]) -->
