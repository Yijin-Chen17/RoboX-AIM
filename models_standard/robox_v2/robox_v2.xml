    <mesh name="part_12" file="part_12.obj" />
    <mesh name="part_13" file="part_13.obj" />
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true" />
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" friction="1.0 0.005 0.0001" />

    <!-- Robot Chassis & Suspensions (30.00 kg Standard) -->
