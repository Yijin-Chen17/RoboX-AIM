    <exclude body1="Posture_control_joint_LB" body2="Wheel_joint_LB" />
    <exclude body1="Posture_control_joint_RB" body2="Wheel_joint_RB" />
  </contact>

  <!-- Standard Standing Keyframe (q_ecc = pi, height = 0.228m) -->
  <keyframe>
    <!-- root_pos(3), root_quat(4), LF_str, LF_ecc, LF_whl, RF_str, RF_ecc, RF_whl, LB_str, LB_ecc, LB_whl, RB_str, RB_ecc, RB_whl -->
    <key name="home" qpos="0 0 0.228 1 0 0 0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0 0.0 3.14159265 0.0" />
