<mujoco model="robox_v2">
  <compiler angle="radian" eulerseq="xyz" meshdir="meshes" autolimits="true" balanceinertia="true" boundinertia="1e-8" />

  <default>
    <joint armature="0.1" damping="1.0" />
  </default>

  <visual>
    <headlight ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" />
    <quality shadowsize="4096" />
    <global offwidth="1920" offheight="1080" />
    <map shadowclip="0.5" shadowscale="0.8" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"
             markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />

    <!-- ROBOX V2 Visual OBJ Meshes -->
    <mesh name="part_01" file="part_01.obj" />
    <mesh name="part_02" file="part_02.obj" />
    <mesh name="part_03" file="part_03.obj" />
    <mesh name="part_04" file="part_04.obj" />
